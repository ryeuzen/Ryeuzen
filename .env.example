# TopstepX API Configuration
# Copy to .env and fill in your credentials
# Get API key: ProjectX settings → API → Subscribe ($14.50/mo with code "topstep")

TRADING_ENVIRONMENT="DEMO"
API_KEY="your_topstep_api_key_here"
USERNAME="your_topstep_username"

# Contract ID — use current front-month NQ/MNQ contract
# Format: CON.F.US.{SYMBOL}.{MONTH_CODE}{YY}
# Month codes: H=Mar, M=Jun, U=Sep, Z=Dec (quarterly)
CONTRACT_ID="CON.F.US.MNQ.M25"

# Account ID — leave empty to auto-detect first active account
ACCOUNT_ID_TO_WATCH=""
